enum Status(
   code: Int,
   msg: String
) {
    SUCCESS(code: 0, msg: "Success") {

        override fun isSuccess(): Boolean {
            return true
        }
    },
    FAILURE(code: -1, msg: "Failure") {

        override fun isSuccess(): Boolean {
            return false
        }
    };

    abstract fun isSuccess(): Boolean
}

