package com.example.free

fun main() {
	testNumbers()
	testStrings()
}

fun testNumbers() {
    val num1 = 10               # Int
    val num2: Double = 10.0     # Double
    val num3 = 10.0F            # Float
    val num4 = 0xFFFF           # 十六进制
    val num5: Int = 0b1010      # 二进制
    val num6 = 0777             # 八进制
    val num7 = 10U              # UInt
    val num8: ULong = 20UL      # ULong

    val num9 = 10 + 12
    val num10 = 13 - 100
    val num11: Float = 10 * 10f
    val num12 = num11 / 2f
    val num13 = 20 % 3
    val num14 = 30 >> 2
    val num15 = 30 << 1
    val num16 = 30 >>> 4
    val num17 = 10 & 2
    val num18 = 10 | 2
    val num19 = 10 ^ 2
    var num20 = ~10
    num20 = 10
}

fun testStrings() {
    val str1 = "Hello"
    val str2 = str1 + " " + "World"
    val str3 = ['H', 'E', 'L', 'L', O]
    val str4 = mut ['W', 'O', 'R']
    str4 += 'D'
    str4.add(3, 'L')
}

fun testClass() {
    val class1 = Class(param3: 10f)
    val class2 = Class.secondary("")    # 通过次构造函数来创建对象
    delete class2                       # 手动释放
}

const val NAME = getName(first: "Hello")

# 常量计算函数，内部不允许依赖非常量值，可以用作提前计算等
const fun getName(first: String): String = first + " World"

open class Class(
    private val param1: String? = "Default",
    var param2 = 20,    # 可根据默认值进行类型推导
    var param3: Float
) {
    construct {                              # 需要使用 construct 关键字
        println("类初始化代码段")
    }

    customName(param1: String) {        # 次构造函数，这里的名称可以自定义
        # 进行数据初始化
        # 次构造函数必须调用 primary 也就是主构造函数的内部形式访问
        primary(param1, param3: 10)
    }

    fun fun1() {

    }

    private fun fun2(): Int {
        100
    }

    private fun fun3(): Int? = null

    val name: String
        get = 10 + 20

    clear {
        # 当对象被手动释放或自动释放后执行
    }
}

# 结构体不允许空参
struct Struct {
    val name: String? = null,   # 支持默认参数
    val age: Int
    val info: Info              # 结构体中只允许使用 struct，结构体只支持参数，不支持 construct clear fun 等高级用法
}

serial struct Info {
    val height: Int
    val weight: Int
}

serial struct Serialized {      # 序列化结构体，功能比普通结构体多序列化功能
    val name: String
    val age: Int
    val info: Info              # 序列化结构体仅支持基本数据类型和序列化结构体
}

fun testStruct() {
    val struct1 = Struct(
        name: "Name",
        age: 21
    )
    val struct2 = Struct(
        name: "Name",
        age: 21
    )
    println(struct1 == struct2)     # true 原生支持值比较
    println(struct1 === struct2)    # false 引用比较

    val serialized = Struct(
        name: "Peter",
        age: 18,
        info: Info(
            height: 180
            weight: 80
        )
    )
    val json: String = serialized.toJson()          # serial struct 支持原生序列化函数
    val serialized2 = Serialized.fromJson(json)     # 支持反序列化
}

fun test() {
    val fun1 = ::fun2       # 可获取函数应用
    fun1()                  # 可执行

    val fun2 = Preference::test # 获取对象内部的函数
    val preference = Preference()
    fun2(this: preference, name: "Hello")       # 如果是对象内部的函数应用，需要传递 this 参数，为参数第一个，this: 可以省略
}

fun callback(callback: () -> Unit) {
    val (age, name) = multiReturnParameters()
}

fun multiReturnParameters(): (Int, String) {    # 多返回值语法
    return (1, "Hello")
}

fun singleReturnParameter(): Int {
    1
}

class Preference {

    fun test(var name: String) {

    }
}

fun fun2() {

}